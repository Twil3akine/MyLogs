---
import type { Locale } from "@/data/locales";

export interface Props {
  siteTitle?: string;
  lang?: Locale;
}

const { siteTitle = "Twil3akine", lang = "ja" } = Astro.props;
const currentYear = new Date().getFullYear();
const privacyHref = lang === "en" ? "/en/privacy/" : "/privacy/";
const privacyLabel = lang === "en" ? "Privacy Policy" : "プライバシーポリシー";
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-content">
      {
        Astro.slots.has("default") && (
          <div class="footer-actions">
            <slot />
          </div>
        )
      }
      <p class="copyright">
        &copy; {currentYear}
        {siteTitle}. All rights reserved.
      </p>
      <nav class="footer-links" aria-label={lang === "en" ? "Legal" : "サイト情報"}>
        <a href={privacyHref}>{privacyLabel}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--theme-border);
    background-color: var(--theme-bg);
    margin-top: 1.5rem;
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.5rem 2rem;
  }
  .footer-content {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.35rem;
  }
  .copyright {
    margin: 0;
    font-size: 0.85rem;
    color: var(--theme-text);
    opacity: 0.6;
    text-align: center;
  }
  .footer-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .footer-links {
    display: inline-flex;
    align-items: baseline;
    white-space: nowrap;
    font-size: 0.82rem;
  }
  .footer-links::before {
    margin-right: 0.35rem;
    color: var(--theme-text);
    opacity: 0.45;
    content: "·";
  }
  .footer-links a {
    color: var(--theme-text-muted);
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--theme-accent);
  }
  /* スロットで渡されたリンクのスタイルとホバー設定 */
  .footer-actions :global(a) {
    color: var(--theme-text-muted);
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
  }
  .footer-actions :global(a:hover) {
    color: var(--theme-accent);
  }

  @media (max-width: 640px) {
    .footer-inner {
      padding-right: 1rem;
      padding-left: 1rem;
    }
  }
</style>
