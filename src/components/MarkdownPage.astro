---
import DateText from "@/components/DateText.astro";
import AdSense from "@/components/AdSense.astro";
import PageView from "@/components/PageView.astro";
import Tag from "@/components/Tag.astro";
import TOC from "@/components/TOC.svelte";
import { getVisibleHeadings, type MarkdownHeading } from "@/lib/content";

interface Props {
  title: string;
  lead?: string;
  date?: Date;
  tags?: string[];
  headings: MarkdownHeading[];
  variant?: "article" | "profile";
  tagBasePath?: string;
  showAds?: boolean;
  pageViewPath?: string;
  lang?: "ja" | "en";
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  lead,
  date,
  tags = [],
  headings,
  variant = "article",
  tagBasePath,
  showAds = false,
  pageViewPath,
  lang = "ja",
  backHref,
  backLabel,
} = Astro.props;
const visibleHeadings = getVisibleHeadings(headings);
const hasTableOfContents = visibleHeadings.length > 0;
---

<div
  class:list={[
    "markdown-shell",
    `markdown-shell-${variant}`,
    { "markdown-shell-no-toc": !hasTableOfContents },
  ]}
>
  <article class="markdown-content">
    <header>
      <h1>{title}</h1>
      {lead && <p class="markdown-lead">{lead}</p>}
      {
        (date || pageViewPath) && (
          <div class="markdown-meta">
            {date && <DateText date={date} size="large" class="markdown-date" />}
            {pageViewPath && <PageView path={pageViewPath} lang={lang} />}
          </div>
        )
      }
      {
        tags.length > 0 && (
          <div class="markdown-tags" aria-label="Tags">
            {tags.map((tag) => (
              <Tag href={tagBasePath ? `${tagBasePath}?tag=${encodeURIComponent(tag)}` : undefined}>{tag}</Tag>
            ))}
          </div>
        )
      }
    </header>
    <slot />
    {
      backHref && backLabel && (
        <footer class="markdown-back-navigation">
          <a href={backHref} class="markdown-back-link">
            <span aria-hidden="true">←</span>
            <span>{backLabel}</span>
          </a>
        </footer>
      )
    }
  </article>

  {showAds && <div class="markdown-footer-ad"><AdSense placement="footer" /></div>}

  {
    hasTableOfContents && (
      <aside class="markdown-toc">
        <TOC headings={visibleHeadings} client:load />
        {showAds && <AdSense placement="toc" />}
      </aside>
    )
  }
</div>

<style>
  .markdown-shell {
    display: grid;
    grid-template-columns: minmax(0, 768px) minmax(10rem, 14rem);
    grid-template-areas: "content toc";
    gap: clamp(2rem, 4vw, 3rem);
    align-items: start;
    width: min(100%, 1040px);
    margin: 0 auto;
    padding: clamp(2.5rem, 7vw, 5rem) 0;
  }

  :global(main.main-content) {
    max-width: none;
    width: 100%;
  }

  .markdown-content {
    grid-area: content;
    min-width: 0;
  }

  .markdown-footer-ad {
    grid-area: footer-ad;
  }

  .markdown-content header {
    margin-bottom: 2.5rem;
  }

  .markdown-content h1 {
    margin: 0;
    font-size: var(--font-size-page-title);
    line-height: 1.15;
  }

  .markdown-lead {
    margin: 1.2rem 0 0;
    color: color-mix(in srgb, var(--theme-text), transparent 22%);
    font-size: var(--font-size-body-large);
    line-height: 1.9;
  }

  .markdown-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem 1rem;
    margin-top: 1rem;
  }

  .markdown-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .markdown-back-navigation {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--theme-border);
  }

  .markdown-back-link {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    padding: 0.7rem 1rem;
    border: 1px solid var(--theme-border);
    border-radius: 8px;
    color: var(--theme-text);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .markdown-back-link:hover {
    border-color: var(--theme-accent);
    color: var(--theme-accent);
    background-color: var(--theme-accent-bg);
  }

  .markdown-content :global(h2) {
    margin-top: 2.4rem;
  }

  .markdown-shell-profile .markdown-content :global(h2) {
    margin: 2.5rem 0 0.85rem;
    padding-bottom: 0.35rem;
    font-size: var(--font-size-section-title);
    line-height: 1.35;
  }

  .markdown-shell-profile .markdown-content header + :global(h2) {
    margin-top: 0;
  }

  .markdown-shell-profile .markdown-content :global(h2 + p) {
    margin-top: 0.85rem;
  }

  .markdown-shell-profile .markdown-content > :global(p) {
    margin: 0 0 1.1rem;
    color: color-mix(in srgb, var(--theme-text), transparent 10%);
    line-height: 2;
  }

  .markdown-toc {
    grid-area: toc;
    position: sticky;
    top: 5.5rem;
    border-left: 1px solid var(--theme-border);
    padding-left: 1rem;
  }

  .markdown-shell-article {
    grid-template-areas:
      "content toc"
      "footer-ad toc";
    row-gap: 0;
  }

  .markdown-shell-no-toc {
    grid-template-columns: minmax(0, 768px);
    grid-template-areas:
      "content"
      "footer-ad";
    width: min(100%, 768px);
  }

  @media (max-width: 960px) {
    .markdown-shell {
      display: block;
      width: 100%;
    }

    .markdown-toc {
      display: none;
    }

    .markdown-footer-ad {
      display: none;
    }
  }

  @media (max-width: 512px) {
    .markdown-shell {
      padding: 2rem 0 3rem;
    }

    .markdown-content header {
      margin-bottom: 2.25rem;
    }
  }
</style>
