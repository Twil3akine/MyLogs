{
  "name": "mylogs",
  "version": "0.0.1",
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^8.1.2",
    "astro": "6.4.5",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.2",
    "svelte": "^5.53.7"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "db:migrate:local": "wrangler d1 migrations apply mylogs-page-views --local --config wrangler.local.jsonc",
    "dev:pages": "bun run build && wrangler pages dev dist",
    "preview": "astro preview",
    "typegen:functions": "wrangler types ./functions/types.d.ts --include-runtime=false --config wrangler.local.jsonc",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "astro": "astro"
  },
  "type": "module",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "wrangler": "^4.127.1",
    "zod": "^4.3.6"
  }
}
